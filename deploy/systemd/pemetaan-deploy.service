[Unit]
Description=pemetaan - deploy dari GitHub (dipicu webhook)
After=docker.service network-online.target
Requires=docker.service

[Service]
Type=oneshot
# Pengaturan per server (COMPOSE_FILE, PEMETAAN_PORT, ...). Tanda "-" = boleh tidak ada.
EnvironmentFile=-/etc/pemetaan/deploy.env
ExecStart=/srv/pemetaan/deploy/deploy.sh
TimeoutStartSec=20min
